# ==============================================================================
# AegisVision AI — root environment template.
# Copy to .env and fill in real values. NEVER commit the real .env file.
# docker-compose.yml reads this file; the backend also reads it directly when
# run outside Docker (backend/app/core/config.py loads it via pydantic-settings).
# ==============================================================================

# --- Database ---
POSTGRES_USER=aegisvision
POSTGRES_PASSWORD=change-me-in-dev
POSTGRES_DB=aegisvision
POSTGRES_PORT=5432
# Defaults to the local `postgres` container started by docker-compose.yml.
# Point this at a managed Postgres (Supabase or otherwise, with
# sslmode=require appended) for any non-dev deployment instead.
DATABASE_URL=postgresql+psycopg://aegisvision:change-me-in-dev@postgres:5432/aegisvision

# --- Redis (cache + background job queue) ---
REDIS_PASSWORD=change-me-in-dev
REDIS_URL=redis://:change-me-in-dev@redis:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Shared verbatim by backend AND ai-engine (both validate the same user JWT —
# see ai-engine/inference/security.py) — keep them in sync.
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true once served over HTTPS in production (marks the refresh cookie Secure).
REFRESH_COOKIE_SECURE=false

# --- Service-to-service auth ---
# Shared secret video-engine sends as X-Service-Key when calling backend's
# /api/v1/internal/* routes and ai-engine's /pipeline/* routes. Not a user
# credential — never exposed to the browser.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_API_KEY=change-me-to-a-long-random-value

# --- Storage ---
# STORAGE_BACKEND: local | s3
STORAGE_BACKEND=local
# Relative to each service's working directory (backend: /backend, ai-engine
# and video-engine: /app) so the same value resolves correctly everywhere
# once ./storage is bind-mounted at that working directory.
UPLOAD_DIR=./storage/uploads
MEDIA_DIR=./storage/media
MAX_UPLOAD_SIZE_MB=2048
# S3 / S3-compatible (Cloudflare R2, MinIO) — used only when STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- AI / Detection ---
AI_MODEL_PATH=yolov8n.pt
AI_DEVICE=cpu
FRAME_SAMPLE_FPS=2

# --- Rule engine thresholds ---
LOITERING_THRESHOLD_SECONDS=30
INTRUSION_COOLDOWN_SECONDS=60
FALL_CONFIDENCE_THRESHOLD=0.5

# --- Retention (days). Leave blank to disable automatic cleanup. ---
VIDEO_RETENTION_DAYS=90
EVENT_RETENTION_DAYS=180
INCIDENT_RETENTION_DAYS=365

# --- LLM provider (query parsing + evidence summarization) ---
# LLM_PROVIDER: none | anthropic | openai
# When "none" or unset, the system falls back to deterministic rule-based
# query parsing and templated evidence summaries — investigation search
# remains fully functional without an API key.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# --- Embeddings (semantic search over event descriptions, pgvector) ---
# EMBEDDING_PROVIDER: local | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Seed / demo admin account (used only by scripts/seed.py) ---
SEED_ORG_NAME=Demo Security
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=change-me-strong-password

# --- ai-engine service (YOLO/DeepSORT/gait pipeline, standalone FastAPI on :8001) ---
GAIT_ALERT_THRESHOLD=0.85
DEMO_DATA_DIR=./storage/ai-engine

# --- video-engine service (RTSP ingestion, HLS live streaming, clips/snapshots,
# standalone FastAPI on :8002) ---
BACKEND_URL=http://backend:8000
AI_ENGINE_URL=http://ai-engine:8001
CAMERA_POLL_INTERVAL_SECONDS=30
SNAPSHOT_INTERVAL_SECONDS=15
CLIP_FORWARD_INTERVAL_SECONDS=12
FRAME_BUFFER_SECONDS=30
SEGMENT_RETENTION_SECONDS=300
# Looped when a camera has no stream_url (e.g. the seeded UPLOAD-type demo
# cameras) so the full ingestion pipeline is exercisable without a real
# RTSP camera. Relative to video-engine's working directory (/app).
DEMO_FALLBACK_VIDEO=./storage/uploads/sample-walking-realistic.mp4

# --- Frontend (read in the browser — must be reachable from the user's machine,
# not just inside the docker network, so these stay as localhost ports) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AI_ENGINE_URL=http://localhost:8001
NEXT_PUBLIC_VIDEO_ENGINE_URL=http://localhost:8002

# --- Misc ---
ENV=development
LOG_LEVEL=INFO
