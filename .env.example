# Postgres — only used to configure the local docker-compose `postgres`
# container. If you're using Supabase (or any external Postgres) instead,
# leave these as-is and set DATABASE_URL/DIRECT_URL below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=video_analytics
POSTGRES_PORT=5432

# Set these to use Supabase (or any external Postgres) instead of the local
# docker-compose `postgres` container — see backend/packages/database/.env.example
# for where to find each value in the Supabase dashboard.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Redis
REDIS_PORT=6379

# API
API_PORT=3000
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12
CAMERA_CREDENTIALS_ENCRYPTION_KEY=Wgt+6YWaq8BhPCGWc7QqrgPhsBMYU4mvahqWER+c13I=
CAMERA_HEALTH_POLL_CONCURRENCY=5

# Recordings storage + live preview (RTSP -> HLS transcoding)
STORAGE_DIR=./storage
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_UPLOAD_SIZE_MB=500
LIVE_STREAM_MAX_DURATION_MS=1800000

# AI Service
AI_SERVICE_PORT=8000

# Bootstrap organization + admin (used only by `npm run prisma:seed` /
# `npm run prisma:backfill-default-org`)
ORG_NAME=Default Organization
ORG_SLUG=default
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
