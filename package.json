{
  "name": "video-analytics-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend/apps/api",
    "backend/packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace=@video-analytics/config --workspace=@video-analytics/logger --workspace=@video-analytics/common --workspace=@video-analytics/database",
    "build": "npm run build:packages && npm run build --workspace=backend/apps/api",
    "start:api": "npm run start --workspace=backend/apps/api",
    "start:api:dev": "npm run build:packages && npm run start:dev --workspace=backend/apps/api",
    "lint": "eslint \"backend/**/*.ts\"",
    "format": "prettier --write \"backend/**/*.ts\"",
    "prisma:generate": "npm run prisma:generate --workspace=@video-analytics/database",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace=@video-analytics/database",
    "prisma:seed": "npm run build --workspace=@video-analytics/common && npm run db:seed --workspace=@video-analytics/database",
    "prisma:backfill-default-org": "npm run db:backfill-default-org --workspace=@video-analytics/database"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "find-my-way": "^9.7.0",
    "@nestjs/swagger": {
      "js-yaml": "^5.2.3"
    },
    "fastify": "5.10.0"
  }
}
