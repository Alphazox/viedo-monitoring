# ==============================================================================
# AegisVision AI — ai-engine environment template.
# Copy to .env and adjust as needed. This service is standalone: it does not
# read the repo root .env file. NEVER commit the real .env file.
# ==============================================================================

ENV=development
LOG_LEVEL=DEBUG
PORT=8001

# CORS — allow the dashboard frontend origin. Comma-separated for multiple.
ALLOWED_ORIGINS=http://localhost:3000

# --- Auth ---
# Must match the backend's JWT_SECRET/JWT_ALGORITHM exactly (see backend/
# .env.example) — this service validates the same user access token the
# backend issues, rather than running a second login system. In
# docker-compose both services read the same root .env, so this is kept in
# sync automatically there; set it explicitly when running standalone.
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
# Shared secret for internal service-to-service calls (video-engine calling
# POST /pipeline/ingest-clip) — must match the root .env's SERVICE_API_KEY.
SERVICE_API_KEY=change-me-to-a-long-random-value

# Local, file-backed storage root for the gait gallery (JSON+.npz), the
# alert log (JSON), the cached YOLO weights, and generated demo videos
# (written under DEMO_DATA_DIR/demo-videos). No database this round.
DEMO_DATA_DIR=./data

# --- AI / detection ---
AI_MODEL_PATH=yolov8n.pt
AI_DEVICE=cpu

# --- Gait watchlist ---
GAIT_ALERT_THRESHOLD=0.85

# --- Rule engine thresholds ---
# LOITERING/INTRUSION are mirrored from the root .env.example for
# config-surface parity with the backend, but not yet load-bearing in the
# ported activity heuristic (which keeps a frame-count threshold tuned to
# the few-second synthetic demo clips) — see inference/config.py for why.
# FALL_CONFIDENCE_THRESHOLD IS load-bearing — see fall/detector.py — a
# detected fall only raises an alert at or above this confidence.
LOITERING_THRESHOLD_SECONDS=30
INTRUSION_COOLDOWN_SECONDS=60
FALL_CONFIDENCE_THRESHOLD=0.5

# --- Demo sample clips (optional) ---
# /fall/demo/run and /detection/demo/run need a real (or realistic) clip —
# synthetic stick figures don't produce a usable bbox for either. Place
# your own at these paths under DEMO_DATA_DIR to enable the one-click demo
# buttons; neither is bundled in the image or the repo.
#   DEMO_DATA_DIR/samples/fall-demo.mp4
#   DEMO_DATA_DIR/samples/object-detection-demo.mp4
