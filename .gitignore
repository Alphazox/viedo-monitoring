# Node
node_modules/
.next/
out/
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env
.env
.env.*.local
!.env.example
!*/.env.example

# Local-machine-specific compose overrides (e.g. networking workarounds),
# never committed — see docker-compose.yml for the shared, real config.
docker-compose.override.yml

# Storage (dev-local media, never committed)
storage/uploads/*
storage/media/**/*
storage/demo-videos/*
storage/ai-engine/**/*
!storage/uploads/.gitkeep
!storage/media/**/.gitkeep
!storage/demo-videos/.gitkeep
!storage/ai-engine/.gitkeep

# Local ai-engine data volume (gait gallery, alerts, YOLO weights, demo
# samples) used when running the container with a bind mount outside
# docker-compose — dev-local only, never committed.
ai-engine-data/

# AI model weights (fetched at build/runtime, not committed)
*.pt
*.onnx
!.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Alembic local sqlite (if ever used for quick tests)
*.sqlite3

# Coverage
.coverage
htmlcov/
coverage.xml
