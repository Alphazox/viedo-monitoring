# Local Postgres (docker-compose):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_analytics?schema=public
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/video_analytics?schema=public

# Supabase: get both from Project Settings -> Database -> Connection string
# in the Supabase dashboard.
# - DATABASE_URL = "Transaction" pooler string (port 6543, includes
#   ?pgbouncer=true) — used by the running API for normal queries.
# - DIRECT_URL = "Session"/direct string (port 5432, no pgbouncer) — used
#   only by `prisma migrate` to run DDL, which pgbouncer's transaction mode
#   can't do.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Used only by `npm run prisma:seed` / `npm run prisma:backfill-default-org`
ORG_NAME=Default Organization
ORG_SLUG=default
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
