    "jest": "^29.7.0",
    "pino-pretty": "^11.2.2",
    "ts-jest": "^29.2.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
