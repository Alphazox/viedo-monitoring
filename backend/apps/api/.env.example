NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Using Supabase instead of local Postgres? Use the pooled ("Transaction")
# connection string here (port 6543, ?pgbouncer=true) — see
# backend/packages/database/.env.example for the DIRECT_URL migrations need.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_analytics?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=*

# JWT
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12

# Camera credential encryption (Phase 4) — base64-encoded 32-byte AES-256 key.
# Change this in production: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
CAMERA_CREDENTIALS_ENCRYPTION_KEY=Wgt+6YWaq8BhPCGWc7QqrgPhsBMYU4mvahqWER+c13I=
CAMERA_HEALTH_POLL_CONCURRENCY=5
